# DealLens processing worker. Copy to processing/.env (git-ignored).
# Direct Postgres connection (Supabase: Project Settings → Database → connection string, session mode).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# Supabase API URL and service-role key, used only to read/write private Storage objects.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# Optional tuning
WORKER_ID=worker-local
WORKER_POLL_SECONDS=3
JOB_TIMEOUT_SECONDS=300
