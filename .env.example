# ---------------------------------------------------------------------------
# DealLens environment variables — placeholders only. Copy to .env.local (git-ignored).
# ---------------------------------------------------------------------------

# [required: local + production] Supabase project API settings (Project Settings → API).
# For the local stack, `npx supabase status` prints these values.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# [required for superadmin bootstrap only] Service-role key. SERVER ONLY — never prefix with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# [optional] Verified Google email that is promoted to superadmin on first sign-in. Remove after bootstrap.
SUPERADMIN_BOOTSTRAP_EMAIL=

# [required: production] Public base URL of the deployed app (used for invitation links).
APP_BASE_URL=http://localhost:3000

# Google OAuth credentials are configured in Supabase (Dashboard → Authentication → Providers → Google),
# or for the local stack in supabase/.env. The Next.js app does not need them.

# ---------------------------------------------------------------------------
# Processing worker (processing/.env) — see processing/.env.example
# ---------------------------------------------------------------------------
